# Copy this file to .env and change values for your machine.
# Keep both credential files outside version control.
GOOGLE_CLIENT_SECRETS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
RECRUITER_DB_PATH=data/recruiter_tracker.db

# Searches all mail except spam and trash. Every message contributes metadata,
# while the importer retains full bodies only for likely recruiting messages.
GMAIL_QUERY=in:all

# The importer waits between API calls and retries temporary quota errors.
GMAIL_REQUEST_DELAY_SECONDS=1.0
